# ==============================================================================
# SERVICLIENT CRM HELPDESK - CONFIGURACIÓN DE ENTORNO DOCKER
# ==============================================================================
# Copia este archivo como '.env' para personalizar la configuración local:
#   cp .env.example .env
#
# Si no se crea el archivo .env, docker compose utilizará de manera automática
# los valores por defecto definidos en docker-compose.yml.
# ==============================================================================

# Puerto en el host donde se publicará la aplicación web (http://localhost:8080)
APP_PORT=8080

# Perfil activo de Spring Boot (mysql para contenedores / dev para pruebas locales con H2)
SPRING_PROFILES_ACTIVE=mysql

# Puerto en el host para conexiones externas a MySQL (Workbench, DBeaver, etc.)
DB_PORT=3306

# Parámetros de la base de datos MySQL
DB_NAME=serviclient
DB_USER=serviclient_user
DB_PASSWORD=serviclient_pass
DB_ROOT_PASSWORD=root1234

# Zona horaria
TZ=America/Lima

