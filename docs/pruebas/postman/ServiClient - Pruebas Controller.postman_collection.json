    {
      "name": "02 - GESTIÓN DE CLIENTES",
      "item": [
        {
          "name": "04 - Listado de clientes autenticado",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const respuesta = pm.response.text();\r",
                  "\r",
                  "pm.test(\"CP-04: Código HTTP 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"CP-04: La respuesta es HTML\", function () {\r",
                  "    const tipo = pm.response.headers.get(\"Content-Type\") || \"\";\r",
                  "    pm.expect(tipo).to.include(\"text/html\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"CP-04: Contiene el módulo de clientes\", function () {\r",
                  "    pm.expect(respuesta.toLowerCase()).to.include(\"clientes\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"CP-04: Incluye el campo de búsqueda\", function () {\r",
                  "    pm.expect(respuesta).to.match(\r",
                  "        /name=[\"']busqueda[\"']/i\r",
                  "    );\r",
                  "});\r",
                  "\r",
                  "pm.test(\"CP-04: Tiempo menor a 10 segundos\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(10000);\r",
                  "});\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
